{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "REPO_STAR_DOWNSTREAM_GENERICITY_PROOF_RECEIPT",
  "description": "Two-target read-only downstream genericity receipt for repo-star capabilities.",
  "type": "object",
  "required": [
    "artifact",
    "schema_version",
    "generated_at",
    "source_issue_or_pr",
    "proof_root",
    "target_identities",
    "target_git_state_matrix",
    "target_native_gate_matrix",
    "repo_star_command_list",
    "output_roots",
    "privacy_redaction_note",
    "bma_ceremony_leakage_checklist",
    "github_summary_surface",
    "owner_routing",
    "genericity_verdict",
    "bounded_non_claims"
  ],
  "properties": {
    "artifact": {
      "type": "string",
      "const": "REPO_STAR_DOWNSTREAM_GENERICITY_PROOF_RECEIPT"
    },
    "schema_version": {
      "type": [
        "integer",
        "string"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_issue_or_pr": {
      "type": "string",
      "minLength": 1
    },
    "proof_root": {
      "type": "string",
      "minLength": 1
    },
    "target_identities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "target_key",
          "target_repo_identity",
          "target_path_or_name",
          "target_is_non_bma",
          "privacy_redaction_note"
        ],
        "properties": {
          "target_key": {
            "type": "string",
            "minLength": 1
          },
          "target_repo_identity": {
            "type": "string",
            "minLength": 1
          },
          "target_path_or_name": {
            "type": "string",
            "minLength": 1
          },
          "target_remote_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_is_non_bma": {
            "type": "boolean",
            "const": true
          },
          "privacy_redaction_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "target_git_state_matrix": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "target_key",
          "git_head_before",
          "git_head_after",
          "git_status_before",
          "git_status_after",
          "read_only_state_preserved"
        ],
        "properties": {
          "target_key": {
            "type": "string",
            "minLength": 1
          },
          "git_head_before": {
            "type": "string",
            "minLength": 1
          },
          "git_head_after": {
            "type": "string",
            "minLength": 1
          },
          "git_status_before": {
            "type": "string"
          },
          "git_status_after": {
            "type": "string"
          },
          "read_only_state_preserved": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "target_native_gate_matrix": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "target_key",
          "target_gate_state",
          "gate_receipt_path",
          "evidence_summary"
        ],
        "properties": {
          "target_key": {
            "type": "string",
            "minLength": 1
          },
          "target_gate_state": {
            "type": "string",
            "enum": [
              "no_retained_gate",
              "parseable_pass",
              "parseable_warning",
              "parseable_fail",
              "partial_run",
              "stale_fleet_metric",
              "true_target_risk",
              "amendment_required_unknown"
            ]
          },
          "gate_receipt_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "repo_star_command_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tool",
          "target_key",
          "status"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "repo-auditor",
              "repo-upgrade-advisor",
              "repo-optimizer"
            ]
          },
          "target_key": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "skipped",
              "blocked",
              "not_run"
            ]
          },
          "receipt_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "skip_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "output_roots": {
      "type": "object",
      "minProperties": 1
    },
    "privacy_redaction_note": {
      "type": "string",
      "minLength": 1
    },
    "bma_ceremony_leakage_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "github_summary_surface": {
      "type": "string",
      "minLength": 1
    },
    "owner_routing": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "blocker_family",
          "owner_surface",
          "next_owner_action"
        ],
        "properties": {
          "blocker_family": {
            "type": "string",
            "minLength": 1
          },
          "owner_surface": {
            "type": "string",
            "enum": [
              "repo-agent-core",
              "repo-auditor",
              "repo-upgrade-advisor",
              "repo-optimizer",
              "build-meta-analysis"
            ]
          },
          "next_owner_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "genericity_verdict": {
      "type": "string",
      "enum": [
        "pass",
        "partial",
        "fail",
        "blocked",
        "not_run"
      ]
    },
    "bounded_non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}

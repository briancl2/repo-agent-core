{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SOURCE_INSIGHT_PACKET",
  "description": "Portable source-intelligence intake packet for equal first-pass source insight, evidence-tiered claims, and owner-surface routing.",
  "type": "object",
  "required": [
    "generated_at",
    "schema_version",
    "artifact",
    "source_bundle",
    "sources",
    "claims",
    "high_signal_findings",
    "consumer_targets",
    "bounded_non_claims"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "string"
    },
    "artifact": {
      "type": "string",
      "const": "SOURCE_INSIGHT_PACKET"
    },
    "source_bundle": {
      "type": "object",
      "required": [
        "bundle_id",
        "campaign_ref",
        "operator_intent"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 3
        },
        "campaign_ref": {
          "type": "string",
          "minLength": 3
        },
        "operator_intent": {
          "type": "string",
          "minLength": 20
        },
        "source_surface": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_kind",
          "access_state",
          "insight_disposition"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 3
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "official_doc",
              "repo",
              "operator_supplied_link",
              "social_or_field_report",
              "blog_or_essay",
              "session_log",
              "local_artifact",
              "historical_commit",
              "other"
            ]
          },
          "url_or_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "access_state": {
            "type": "string",
            "enum": [
              "read",
              "partial",
              "inaccessible",
              "rejected"
            ]
          },
          "insight_disposition": {
            "type": "string",
            "enum": [
              "insight",
              "no_insight",
              "contradiction",
              "inaccessible"
            ]
          },
          "insight_summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "no_action_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "claim",
          "source_ids",
          "evidence_tier",
          "effect_on_decision"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 3
          },
          "claim": {
            "type": "string",
            "minLength": 10
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "evidence_tier": {
            "type": "string",
            "enum": [
              "official_current_fact",
              "local_proof",
              "field_signal",
              "frontier_hypothesis",
              "sandbox_experiment",
              "rejected_or_inaccessible"
            ]
          },
          "effect_on_decision": {
            "type": "string",
            "enum": [
              "promote",
              "defer",
              "demote",
              "reject",
              "no_action"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "high_signal_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "summary",
          "source_ids",
          "disposition",
          "owner_surface"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 3
          },
          "summary": {
            "type": "string",
            "minLength": 10
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "disposition": {
            "type": "string",
            "enum": [
              "owner_surface_candidate",
              "github_issue_candidate",
              "roadmap_disposition",
              "explicit_no_action",
              "rejected_or_inaccessible"
            ]
          },
          "owner_surface": {
            "type": "string",
            "minLength": 3
          },
          "action_summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "no_action_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "consumer_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "repo-auditor",
          "repo-upgrade-advisor",
          "repo-optimizer",
          "build-meta-analysis",
          "other"
        ]
      }
    },
    "bounded_non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  },
  "additionalProperties": true
}
